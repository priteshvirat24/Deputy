{
  "name": "deputy-monorepo",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.16.0",
  "scripts": {
    "dev": "pnpm --parallel --filter @deputy/server --filter @deputy/web dev",
    "dev:server": "pnpm --filter @deputy/server dev",
    "dev:web": "pnpm --filter @deputy/web dev",
    "build": "pnpm --filter \"./packages/*\" build && pnpm --filter @deputy/server build && pnpm --filter @deputy/web build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint . --ext .ts,.tsx",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"**/*.{ts,tsx,json,md,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,json,md,css}\"",
    "db:generate": "pnpm --filter @deputy/database db:generate",
    "db:migrate": "pnpm --filter @deputy/database db:migrate",
    "db:check": "tsx scripts/db-check.ts",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@eslint/js": "^9.21.0",
    "@playwright/test": "^1.50.1",
    "@types/node": "^22.13.9",
    "eslint": "^9.21.0",
    "globals": "^16.0.0",
    "prettier": "^3.5.3",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.26.0",
    "vitest": "^3.0.7"
  }
}
