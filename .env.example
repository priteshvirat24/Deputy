# DEPUTY Production & Development Environment Configuration
# Copy this file to .env for local development

NODE_ENV=development
PORT=4000
HOST=127.0.0.1
ORIGIN=http://localhost:5173
WEBAUTHN_ORIGIN=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Database configuration (PostgreSQL)
REPOSITORY_MODE=MEMORY
ALLOW_IN_MEMORY_DEV=true
DATABASE_URL=postgres://postgres:postgres@localhost:5432/deputy_dev

# WebAuthn Configuration
RP_ID=localhost
RP_NAME=DEPUTY Authority

# Security & Sessions
SESSION_SECRET=dev_super_secret_session_key_minimum_32_characters_long
RATE_LIMIT_BACKEND=memory
# REDIS_URL=redis://localhost:6379

# Logging
LOG_LEVEL=info
WEBMCP_DEBUG=true
