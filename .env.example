# DEPUTY Production & Development Environment Configuration
# Copy this file to .env for local development

NODE_ENV=development
PORT=4000
HOST=127.0.0.1
ORIGIN=http://localhost:5173
WEBAUTHN_ORIGIN=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Database configuration (PostgreSQL)
# MEMORY: zero-dependency in-memory repositories (local dev / demo cold open).
# POSTGRES: durable Postgres (e.g. Supabase). Apply packages/database/migrations
# to the target first; the server does not run migrations on boot.
REPOSITORY_MODE=MEMORY
ALLOW_IN_MEMORY_DEV=true
DATABASE_URL=postgres://postgres:postgres@localhost:5432/deputy_dev
# Supabase (production) — use the Supavisor SESSION pooler (IPv4, port 5432);
# the client disables prepared statements so the pooler works. Example shape:
# REPOSITORY_MODE=POSTGRES
# DATABASE_URL=postgresql://<db_role>.<project_ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# WebAuthn Configuration
RP_ID=localhost
RP_NAME=DEPUTY Authority

# Security & Sessions
SESSION_SECRET=dev_super_secret_session_key_minimum_32_characters_long
RATE_LIMIT_BACKEND=memory
# REDIS_URL=redis://localhost:6379

# Logging
LOG_LEVEL=info
WEBMCP_DEBUG=true

# Single-origin static serving
# Local dev leaves this false and uses the Vite proxy (web :5173 -> api :4000).
# A single-origin production deploy sets SERVE_STATIC=true so the API server
# also serves the built SPA (apps/web/dist) at the same origin the passkey RP uses.
SERVE_STATIC=false
# STATIC_DIR=/absolute/path/to/apps/web/dist   # optional override

# ---------------------------------------------------------------------------
# Production single-origin deploy (example — replace deputy.example.com)
# In production the server refuses to boot if RP_ID is localhost or if
# ORIGIN / WEBAUTHN_ORIGIN are not https:// (WebAuthn needs a secure context).
# ---------------------------------------------------------------------------
# NODE_ENV=production
# SERVE_STATIC=true
# PORT=10000
# HOST=0.0.0.0
# RP_ID=deputy.example.com
# ORIGIN=https://deputy.example.com
# WEBAUTHN_ORIGIN=https://deputy.example.com
# ALLOWED_ORIGINS=https://deputy.example.com
# REPOSITORY_MODE=MEMORY
# ALLOW_IN_MEMORY_DEV=true
# SESSION_SECRET=<a real 32+ character random secret>
